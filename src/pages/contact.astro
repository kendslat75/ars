---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Antique Radio Salvage" description="Contact Antique Radio Salvage about selling vacuum tubes, professional testing, product questions or general inquiries." current="contact">
  <section class="page-hero"><div class="container"><p class="eyebrow">Contact</p><h1>How can we help?</h1><p class="lead">Use this form for selling, testing, buying, listing questions and general inquiries.</p></div></section>
  <section class="section"><div class="container content-grid"><div>
    <form class="content-card form" action="https://formspree.io/f/xzepbarv" method="POST">
      <input type="hidden" name="_subject" value="New Antique Radio Salvage Website Inquiry" />
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
      <div class="field"><label for="reason">Reason for contacting us *</label><select id="reason" name="reason" required><option value="">Select an inquiry type</option><option value="selling">Selling tubes or a collection</option><option value="testing">Tube testing services</option><option value="buying">Buying tubes / product question</option><option value="listing">eBay listing question</option><option value="general">General inquiry</option></select></div>
      <div class="form-grid"><div class="field"><label for="name">Name *</label><input id="name" name="name" autocomplete="name" required /></div><div class="field"><label for="email">Email address *</label><input id="email" name="email" type="email" autocomplete="email" required /></div></div>
      <div class="field"><label for="phone">Phone number <span class="small">(optional)</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" /></div>
      <div class="field"><label for="comments">Comments *</label><textarea id="comments" name="comments" required placeholder="Tell us about your tubes, collection, testing needs, item question or general inquiry."></textarea></div>
      <button class="btn primary" type="submit">Send Inquiry</button>
      <p class="small">Your information is sent through Formspree to Antique Radio Salvage and is used only to respond to your inquiry.</p>
    </form>
  </div><aside class="sidebar"><div class="content-card"><h3>Direct contact</h3><p><strong>Phone</strong><br /><a class="text-link" href="tel:9788752078">978-875-2078</a></p><p><strong>Email</strong><br /><a class="text-link" href="mailto:ken@antiqueradiosalvage.com">ken@antiqueradiosalvage.com</a></p><p><strong>Location</strong><br />Hudson, Massachusetts</p></div><div class="content-card" style="margin-top:20px"><h3>Selling a collection?</h3><p>Describe the approximate quantity, how the collection was acquired and your general location. We will reply with guidance on the most useful photos.</p></div></aside></div></section>
</BaseLayout>
